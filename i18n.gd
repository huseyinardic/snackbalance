static var _done := false

static func setup() -> void:
	if _done:
		return
	_done = true
	if OS.get_locale_language() == "in":                 # eski Endonezce kodu
		TranslationServer.set_locale("id")
	for pair in [["pt", PT], ["tr", TR], ["es", ES], ["id", ID], ["de", DE]]:
		var t := Translation.new()
		t.locale = pair[0]
		var d: Dictionary = pair[1]
		for k in d:
			t.add_message(k, d[k])
		TranslationServer.add_translation(t)

static func t(s: String) -> String:
	return TranslationServer.translate(s)

static func lang() -> String:
	return TranslationServer.get_locale().substr(0, 2)

# Sıra: "3rd" / "3º" / "3.º" / "3." / "ke-3"
static func ordinal(r: int) -> String:
	match lang():
		"pt":
			return "%dº" % r
		"es":
			return "%d.º" % r
		"tr", "de":
			return "%d." % r
		"id":
			return "ke-%d" % r
	var suf := "th"
	if r % 100 < 11 or r % 100 > 13:
		suf = ["th", "st", "nd", "rd", "th", "th", "th", "th", "th", "th"][r % 10]
	return "%d%s" % [r, suf]
